# Usługa systemd (użytkownika) uruchamiająca Terminator NFZ bez końca.
# Instalacja: patrz README, sekcja „Na stałe: systemd”.
[Unit]
Description=Terminator NFZ – powiadomienia o wolnych terminach
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Katalog z programem, config.toml i .env (zmień, jeśli trzymasz go gdzie indziej).
WorkingDirectory=%h/terminator-nfz
# Gotowy plik ./terminator-nfz, a jeśli go nie ma – wersja z Pythonem z .venv.
ExecStart=/bin/sh -c 'if [ -x ./terminator-nfz ]; then exec ./terminator-nfz run; else exec .venv/bin/terminator-nfz run; fi'
Restart=always
RestartSec=60

[Install]
WantedBy=default.target
